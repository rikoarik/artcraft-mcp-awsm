{
  "name": "my-awsm-mcp",
  "version": "1.0.0",
  "description": "One local MCP gateway for design engineering, SolidCraft 3D workflows, assets and UI review.",
  "repository": { "type": "git", "url": "git+https://github.com/rikoarik/artcraft-mcp-awsm.git" },
  "homepage": "https://github.com/rikoarik/artcraft-mcp-awsm#readme",
  "bugs": { "url": "https://github.com/rikoarik/artcraft-mcp-awsm/issues" },
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "my-awsm-mcp": "build/index.js",
    "my-awsm-setup": "build/setup.js"
  },
  "files": [
    "build",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/setup.js",
    "test": "npm run build && node test/smoke.mjs",
    "demo": "npm run build && node demo/make-demo.mjs",
    "setup": "node build/setup.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "skills",
    "icons",
    "images",
    "prototype",
    "motion",
    "web-prototype",
    "animation"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
